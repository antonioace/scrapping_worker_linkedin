# Copia a .env. Docker Compose carga estas variables al iniciar worker.
# Backend y scraper comparten la red externa web en el mismo servidor Linux.
JOBS_API_URL=http://job-tracker-api:8000

# OBLIGATORIO: copia EXACTAMENTE JOBS_INGEST_TOKEN del .env privado del backend.
# Si todavía no existe, genera uno con openssl rand -hex 32 y guárdalo en AMBOS.
JOBS_INGEST_TOKEN=""

# No necesita VAPID, Firebase Admin, PostgreSQL ni claves/contraseñas de LinkedIn.
# Opcional, solo una RUTA al JSON privado; nunca pegues las cookies en .env.
# Python local: LINKEDIN_COOKIES_FILE=./linkedin.cookies.json
# Docker: docker-compose.cookies.yml configura la ruta interna automáticamente.
LINKEDIN_COOKIES_FILE=
# Sin esta opción, la sesión se crea con login y se conserva en linkedin-data.
# No necesita dominio ni router Traefik.
# Para Python fuera de Docker, exporta estas variables antes de ejecutar el script;
# el script no carga .env automáticamente (ver README.md).
# Intervalo y filtros se configuran por argumentos: --interval, --keywords, --location.
